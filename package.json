{
  "name": "uninvert-file-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_DEFAULT_FOLDER=\"${INV_VIEWER_DEFAULT_FOLDER:-/home/danc/.diadev/docs}\" sh -c 'node server.mjs & api_pid=$!; vite --host 127.0.0.1; status=$?; kill $api_pid 2>/dev/null; wait $api_pid 2>/dev/null; exit $status'",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  }
}
