{
  "name": "railroad-logistics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_DEFAULT_FOLDER=\"${RAILROAD_LOGISTICS_DEFAULT_FOLDER:-/home/danc/.diadev/docs}\" sh -c 'node server.mjs & api_pid=$!; vite --host 127.0.0.1; status=$?; kill $api_pid 2>/dev/null; wait $api_pid 2>/dev/null; exit $status'",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  }
}
